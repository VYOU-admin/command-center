{
  "name": "command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Monitoring spine: pluggable ingest adapters -> Postgres -> dashboard + Discord alerts",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "run-once": "npm run build && node dist/cli/run-once.js",
    "alert-test": "npm run build && node dist/cli/alert-test.js"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "rss-parser": "^3.13.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
