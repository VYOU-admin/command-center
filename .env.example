# Copy to .env for local development. Never commit the real .env.
# On Railway these are set as service variables, not from a file.

# Postgres connection string. Required — the app refuses to boot without it.
# Railway provides this automatically when you attach a Postgres database.
DATABASE_URL=postgresql://user:password@localhost:5432/command_center

# Discord incoming webhook for failure alerts. Optional but strongly recommended:
# without it, a failing monitor only surfaces on the dashboard and /health.
DISCORD_WEBHOOK_URL=

# Port for the web server. Railway sets this automatically; default 3000 locally.
PORT=3000

# debug | info | warn | error
LOG_LEVEL=info
