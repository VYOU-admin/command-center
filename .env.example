# Copy to .env for local development. Never commit the real .env.
# On Railway these are set as service variables, not from a file.

# Postgres connection string. Required — the app refuses to boot without it.
# Railway provides this automatically when you attach a Postgres database.
DATABASE_URL=postgresql://user:password@localhost:5432/command_center

# Discord alert routing.
#
# Alerts are split by kind, not by monitor:
#   - failure and recovery alerts, from EVERY monitor -> the system channel
#   - content alerts -> the channel named in that monitor's alerts.channel
#
# A monitor's alerts.channel value resolves to DISCORD_WEBHOOK_<CHANNEL> here.
# Adding a channel means setting a variable and naming it in YAML — no code
# change — so these three are a starting point, not a fixed list.
DISCORD_WEBHOOK_SYSTEM=
DISCORD_WEBHOOK_CRYPTO=
DISCORD_WEBHOOK_OIL=

# Fallback used when a named channel has no webhook of its own, so a forgotten
# variable misroutes an alert instead of silencing it. Falling back is logged as
# a warning and shown in /health, because a misrouted alert is delivered
# successfully and therefore looks fine from the sending side.
DISCORD_WEBHOOK_URL=

# Port for the web server. Railway sets this automatically; default 3000 locally.
PORT=3000

# debug | info | warn | error
LOG_LEVEL=info
